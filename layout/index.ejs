<div class="container article-stream">
  <% page.posts.each(function(post) { %>
    <article class="article-item">
      <!-- Quiet Typographic Metadata Row -->
      <div class="article-meta">
        <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
        <% if (post.categories && post.categories.length) { %>
          <span style="opacity: 0.5;">·</span>
          <span><%= post.categories.data[0].name %></span>
        <% } %>
        <% if (theme.reading_info && theme.reading_info.enable) { %>
          <span style="opacity: 0.5;">·</span>
          <span><%= claude_read_time(post.content) %> <%= __('read_time') %></span>
        <% } %>
      </div>

      <!-- Title -->
      <h2 style="margin: 0; font-size: inherit;">
        <a href="<%- url_for(post.path) %>" class="article-title">
          <%= post.title || 'Untitled' %>
        </a>
      </h2>

      <!-- Summary / Excerpt -->
      <% const summary = post.description || post.excerpt || post.content.replace(/<[^>]+>/g, '').substring(0, 160) + '...'; %>
      <p class="article-summary">
        <%= summary %>
      </p>

      <!-- Tags -->
      <% if (post.tags && post.tags.length) { %>
        <div class="article-tags">
          <% post.tags.each(function(tag) { %>
            <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </article>
  <% }) %>

  <!-- Pagination -->
  <% if (page.total > 1) { %>
    <nav style="display: flex; justify-content: space-between; align-items: center; margin-top: 2.5rem; font-family: var(--font-mono); font-size: 0.8125rem;">
      <% if (page.prev) { %>
        <a href="<%- url_for(page.prev_link) %>">&larr; <%= __('prev_post') %></a>
      <% } else { %><span></span><% } %>

      <span style="color: var(--text-muted);"><%= page.current %> / <%= page.total %></span>

      <% if (page.next) { %>
        <a href="<%- url_for(page.next_link) %>"><%= __('next_post') %> &rarr;</a>
      <% } else { %><span></span><% } %>
    </nav>
  <% } %>
</div>
