<div class="container archive-container">
  <header style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 0.5rem;">
      <%= __('archive') %>
    </h1>
    <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">
      共计 <%= site.posts.length %> 篇文章
    </p>
  </header>

  <% 
    let currentYear = '';
    site.posts.sort('date', 'desc').each(function(post) {
      const year = date(post.date, 'YYYY');
      if (year !== currentYear) {
        if (currentYear !== '') { %>
          </div> <!-- Close previous archive-year-group -->
        <% }
        currentYear = year; %>
        <div class="archive-year-group">
          <div class="archive-year-title"><%= currentYear %></div>
      <% } %>

      <div class="archive-item">
        <time class="archive-date" datetime="<%= date_xml(post.date) %>">
          <%= date(post.date, 'MM-DD') %>
        </time>
        <a href="<%- url_for(post.path) %>" class="archive-link">
          <%= post.title || 'Untitled' %>
        </a>
      </div>
  <% }) %>

  <% if (currentYear !== '') { %>
    </div> <!-- Close last archive-year-group -->
  <% } %>
</div>
